{
  "name": "scano",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "The document scanner that lives in your browser. No upload, no account.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vue-tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test:cv": "esbuild scripts/test-cv.ts --bundle --platform=node --format=esm --outfile=.tmp/test-cv.mjs --log-level=warning && node .tmp/test-cv.mjs",
    "test": "vitest run",
    "ocr:assets": "node scripts/fetch-ocr-assets.mjs",
    "prebuild": "node scripts/fetch-ocr-assets.mjs",
    "predev": "node scripts/fetch-ocr-assets.mjs",
    "sample:image": "esbuild scripts/make-sample.ts --bundle --platform=node --format=esm --external:@napi-rs/canvas --outfile=.tmp/make-sample.mjs --log-level=warning && node .tmp/make-sample.mjs",
    "docs:images": "npm run sample:image && esbuild scripts/make-demo.ts --bundle --platform=node --format=esm --outfile=.tmp/make-demo.mjs --log-level=warning && node .tmp/make-demo.mjs",
    "test:ocr": "node scripts/test-ocr.mjs"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.21.5",
    "jpeg-js": "^0.4.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
