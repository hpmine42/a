{
  "name": "flatbed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The flatbed scanner that lives in your browser. No upload, no account, no install.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test:cv": "esbuild scripts/test-cv.ts --bundle --platform=node --format=esm --outfile=.tmp/test-cv.mjs --log-level=warning && node .tmp/test-cv.mjs"
  },
  "dependencies": {
    "jspdf": "^2.5.2"
  },
  "devDependencies": {
    "jpeg-js": "^0.4.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "esbuild": "^0.21.5"
  }
}
